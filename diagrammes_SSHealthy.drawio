        <mxCell id="c3" value="1. Ouvre la page de validation de commande" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="190" as="sourcePoint" /><mxPoint x="380" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c4" value="2. GET commande.php" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="234" as="sourcePoint" /><mxPoint x="700" y="234" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c5" value="3. Lit le panier dans la session PHP (côté serveur)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;align=left;spacingLeft=6;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="278" as="sourcePoint" /><mxPoint x="700" y="302" as="targetPoint" /><Array as="points"><mxPoint x="740" y="278" /><mxPoint x="740" y="302" /></Array></mxGeometry></mxCell>
        <mxCell id="c6" value="4. SELECT prix et disponibilité des plats du panier" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="340" as="sourcePoint" /><mxPoint x="1020" y="340" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c7" value="5. Prix courants et disponibilités" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#657A6C;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="384" as="sourcePoint" /><mxPoint x="700" y="384" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c8" value="6. Récapitulatif, formulaire et jeton CSRF" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#657A6C;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="428" as="sourcePoint" /><mxPoint x="380" y="428" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c9" value="7. Choisit créneau, mode de retrait, paiement (adresse si livraison)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="472" as="sourcePoint" /><mxPoint x="380" y="472" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c10" value="8. POST commande.php + jeton CSRF" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="516" as="sourcePoint" /><mxPoint x="700" y="516" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c11" value="9. SELECT prix et disponibilité (relecture en base)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="560" as="sourcePoint" /><mxPoint x="1020" y="560" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c12" value="10. Prix courants" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#657A6C;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="604" as="sourcePoint" /><mxPoint x="700" y="604" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c13" value="11. Vérifie le jeton CSRF, le créneau (≥ 45 min), le mode de retrait, le paiement ; recalcule le total" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;align=left;spacingLeft=6;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="648" as="sourcePoint" /><mxPoint x="700" y="672" as="targetPoint" /><Array as="points"><mxPoint x="740" y="648" /><mxPoint x="740" y="672" /></Array></mxGeometry></mxCell>
        <mxCell id="c14" value="12. BEGIN (début de transaction)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="710" as="sourcePoint" /><mxPoint x="1020" y="710" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c15" value="13. INSERT INTO commandes" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="754" as="sourcePoint" /><mxPoint x="1020" y="754" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c16" value="14. Identifiant de la commande (lastInsertId)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#657A6C;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="798" as="sourcePoint" /><mxPoint x="700" y="798" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c17" value="15. INSERT details_commande (plat) ou details_commande_bowls (bowl)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="872" as="sourcePoint" /><mxPoint x="1020" y="872" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c18" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=24;fillColor=none;strokeColor=#234B36;strokeWidth=1.5;fontStyle=1;fontColor=#234B36;" vertex="1" parent="1"><mxGeometry x="560" y="828" width="590" height="76" as="geometry" /></mxCell>
        <mxCell id="c19" value="[pour chaque article du panier]" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;fontColor=#263128;" vertex="1" parent="1"><mxGeometry x="622" y="830" width="320" height="20" as="geometry" /></mxCell>
        <mxCell id="c20" value="16. COMMIT (fin de transaction)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="970" as="sourcePoint" /><mxPoint x="1020" y="970" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c21" value="17. Vider le panier (session PHP)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;align=left;spacingLeft=6;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1014" as="sourcePoint" /><mxPoint x="700" y="1038" as="targetPoint" /><Array as="points"><mxPoint x="740" y="1014" /><mxPoint x="740" y="1038" /></Array></mxGeometry></mxCell>
        <mxCell id="c22" value="18. Confirmation et instructions de paiement" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#657A6C;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1076" as="sourcePoint" /><mxPoint x="380" y="1076" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c23" value="19. ROLLBACK (annulation de la transaction)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1142" as="sourcePoint" /><mxPoint x="1020" y="1142" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c24" value="20. Message d’erreur ; le panier est conservé" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;strokeColor=#657A6C;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1186" as="sourcePoint" /><mxPoint x="380" y="1186" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c25" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=56;height=24;fillColor=none;strokeColor=#234B36;strokeWidth=1.5;fontStyle=1;fontColor=#234B36;" vertex="1" parent="1"><mxGeometry x="340" y="928" width="810" height="290" as="geometry" /></mxCell>
        <mxCell id="c26" value="[toutes les insertions réussissent]" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;fontColor=#263128;" vertex="1" parent="1"><mxGeometry x="402" y="930" width="320" height="20" as="geometry" /></mxCell>
        <mxCell id="c27" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#234B36;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="1104" as="sourcePoint" /><mxPoint x="1150" y="1104" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c28" value="[exception]" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;fontColor=#263128;" vertex="1" parent="1"><mxGeometry x="350" y="1106" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="c29" value="21. Si Wave ou Orange Money : effectue le transfert hors du site" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="1240" as="sourcePoint" /><mxPoint x="1300" y="1240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c30" value="22. Vérifie le transfert puis met à jour le statut (admin/commandes.php)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#234B36;strokeWidth=1.2;fontSize=11;fontColor=#263128;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="1284" as="sourcePoint" /><mxPoint x="700" y="1284" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c31" value="La session PHP qui contient le panier est stockée sur le serveur. Aucun paiement n’est confirmé automatiquement : l’administrateur contrôle le transfert." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF8DD;strokeColor=#D0B96E;fontSize=12;fontColor=#263128;" vertex="1" parent="1"><mxGeometry x="20" y="1380" width="1620" height="46" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
