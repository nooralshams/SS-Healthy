        <mxCell id="72" value="Notation : # identifie l’identifiant conceptuel; les objectifs nutritionnels sont des valeurs enum et non une table autonome. Les bowls personnalisés sont enregistrés séparément des plats du catalogue." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0F7F1;strokeColor=#D0B96E;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
