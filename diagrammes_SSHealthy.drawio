  <diagram id="sshealthy-2" name="Déploiement">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:24px'&gt;SS’Healthy — Diagramme de déploiement&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#607267' style='font-size:13px'&gt;Configuration locale utilisée pour la démonstration sur téléphone (réseau Wi-Fi local)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="35" y="18" width="1850" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;Téléphone du client&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Navigateur mobile&lt;br&gt;URL locale : http://192.168.1.27/zig_healthy/&lt;br&gt;Même réseau Wi-Fi que le PC" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#F5FBF7;strokeColor=#234B36;strokeWidth=1.5;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;PC administrateur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Navigateur web&lt;br&gt;Accès au back-office /admin" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#F5FBF7;strokeColor=#234B36;strokeWidth=1.5;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="70" y="510" width="330" height="145" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;Réseau local (Wi-Fi / LAN)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;HTTP pour la démonstration locale&lt;br&gt;Le serveur doit rester allumé&lt;br&gt;Le pare-feu doit autoriser Apache" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#EFF7F1;strokeColor=#7DA58B;strokeWidth=1.5;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="470" y="340" width="310" height="190" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;Ordinateur hôte — Windows + WampServer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Nœud Web : Apache&lt;br&gt;PHP 8 + application SS’Healthy&lt;br&gt;Pages PHP, includes, CSS, JS, images, vendor/PHPMailer&lt;br&gt;Sessions PHP : panier et authentification" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#E7F5EB;strokeColor=#234B36;strokeWidth=1.5;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="860" y="225" width="470" height="270" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;Serveur de base de données&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;MySQL / MariaDB&lt;br&gt;Base : zig_healthy_db&lt;br&gt;Connexion PDO, port local configuré : 3308" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#F5FBF7;strokeColor=#234B36;strokeWidth=1.5;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="1430" y="215" width="310" height="190" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;Service externe optionnel&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Serveur SMTP (ex. Gmail)&lt;br&gt;Envoi des liens de réinitialisation&lt;br&gt;TLS / port 587 si configuré" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFF9E8;strokeColor=#B28D33;strokeWidth=1.5;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="1430" y="550" width="310" height="190" as="geometry" />
        </mxCell>
        <mxCell id="9" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#234B36;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="3" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="10" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#234B36;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Requêtes navigateur → Apache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#234B36;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="12" value="PDO / SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#234B36;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13" value="SMTP sécurisé (si activé)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;strokeColor=#9B7A2B;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="6" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Important pour le mémoire :&lt;/b&gt; ce schéma décrit la démonstration locale actuelle, pas un hébergement public. En production, remplacer l’IP locale par un domaine HTTPS et sécuriser la configuration serveur." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0F7F1;strokeColor=#D0B96E;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="470" y="720" width="860" height="70" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Wave et Orange Money ne sont pas des serveurs reliés à l’application : le transfert est fait manuellement par le client." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF8DD;strokeColor=#D0B96E;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="1360" y="770" width="390" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
