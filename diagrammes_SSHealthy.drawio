  <diagram id="sshealthy-7" name="MLD">
    <mxGraphModel dx="2050" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:24px'&gt;SS’Healthy — MLD (modèle logique de données)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#607267' style='font-size:13px'&gt;Schéma relationnel consolidé : script initial + migrations IMC, abonnements, bowls, paiement/contact et réinitialisation&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="35" y="18" width="1850" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="PK = clé primaire · FK = clé étrangère · UQ = contrainte UNIQUE · Les montants sont en FCFA. Les valeurs d’objectif sont des ENUM." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0F7F1;strokeColor=#D0B96E;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="40" y="82" width="1950" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;UTILISATEURS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;nom : VARCHAR(50) NOT NULL&lt;br&gt;prenom : VARCHAR(50) NOT NULL&lt;br&gt;UQ email : VARCHAR(100) NOT NULL&lt;br&gt;mot_de_passe : VARCHAR(255) NOT NULL&lt;br&gt;telephone : VARCHAR(20) NULL&lt;br&gt;objectif : ENUM(...) NULL (défini après l’IMC)&lt;br&gt;role : ENUM(client, admin) DEFAULT client&lt;br&gt;bloque : TINYINT(1) DEFAULT 0&lt;br&gt;date_inscription : DATETIME" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="610" height="278" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;COMMANDES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;FK utilisateur_id → UTILISATEURS.id&lt;br&gt;date_commande : DATETIME&lt;br&gt;creneau : VARCHAR(20) NOT NULL&lt;br&gt;mode : ENUM(sur_place, a_emporter, livraison)&lt;br&gt;mode_paiement : ENUM(especes, wave, orange_money)&lt;br&gt;adresse_livraison : VARCHAR(255) NULL&lt;br&gt;statut : ENUM(...) DEFAULT en_attente&lt;br&gt;total : DECIMAL(10,0)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="705" y="150" width="610" height="255" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;PLATS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;FK categorie_id → CATEGORIES.id&lt;br&gt;nom : VARCHAR(100) NOT NULL&lt;br&gt;description : TEXT&lt;br&gt;prix : DECIMAL(10,0)&lt;br&gt;calories : INT&lt;br&gt;proteines / glucides / lipides : DECIMAL(5,1)&lt;br&gt;ig_faible : TINYINT(1)&lt;br&gt;image : VARCHAR(255)&lt;br&gt;disponible : TINYINT(1)&lt;br&gt;date_ajout : DATETIME" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="1370" y="150" width="610" height="301" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;JETONS_REINITIALISATION&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;FK, UQ utilisateur_id → UTILISATEURS.id&lt;br&gt;UQ empreinte : CHAR(64)&lt;br&gt;expire_le : DATETIME NOT NULL&lt;br&gt;cree_le : DATETIME" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="40" y="555" width="610" height="163" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;DETAILS_COMMANDE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;FK commande_id → COMMANDES.id&lt;br&gt;FK plat_id → PLATS.id&lt;br&gt;quantite : INT DEFAULT 1&lt;br&gt;prix_unitaire : DECIMAL(10,0)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="705" y="555" width="610" height="163" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;DETAILS_COMMANDE_BOWLS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;FK commande_id → COMMANDES.id&lt;br&gt;nom : VARCHAR(120)&lt;br&gt;composition : TEXT (JSON)&lt;br&gt;quantite : INT DEFAULT 1&lt;br&gt;prix_unitaire : DECIMAL(10,0)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="1370" y="555" width="610" height="186" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;CATEGORIES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;nom : VARCHAR(50) NOT NULL&lt;br&gt;description : TEXT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="610" height="117" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;FORMULES_ABONNEMENT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;nom : VARCHAR(100) NOT NULL&lt;br&gt;description : TEXT&lt;br&gt;nb_repas_jour : INT&lt;br&gt;prix : DECIMAL(10,0)&lt;br&gt;duree_jours : INT&lt;br&gt;icone : VARCHAR(10)&lt;br&gt;actif : TINYINT(1)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="705" y="960" width="610" height="232" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;ABONNEMENTS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;FK utilisateur_id → UTILISATEURS.id&lt;br&gt;FK formule_id → FORMULES_ABONNEMENT.id&lt;br&gt;date_souscription : DATETIME&lt;br&gt;date_debut / date_fin : DATE&lt;br&gt;statut : ENUM(...)&lt;br&gt;adresse_livraison : VARCHAR(255) NULL&lt;br&gt;prix : DECIMAL(10,0)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="1370" y="960" width="610" height="232" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;MESURES_IMC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;FK utilisateur_id → UTILISATEURS.id&lt;br&gt;poids / taille : DECIMAL(5,1)&lt;br&gt;imc : DECIMAL(4,1)&lt;br&gt;interpretation : VARCHAR(50)&lt;br&gt;objectif_recommande : ENUM(...)&lt;br&gt;date_mesure : DATETIME" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="40" y="1365" width="610" height="209" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;MESSAGES_CONTACT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK id : INT AUTO_INCREMENT&lt;br&gt;FK utilisateur_id → UTILISATEURS.id NULL&lt;br&gt;nom : VARCHAR(100)&lt;br&gt;email : VARCHAR(190)&lt;br&gt;telephone : VARCHAR(30) NULL&lt;br&gt;message : TEXT&lt;br&gt;statut : ENUM(nouveau, traite)&lt;br&gt;date_message : DATETIME" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="705" y="1365" width="610" height="232" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;PLAT_OBJECTIFS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK, FK plat_id → PLATS.id&lt;br&gt;PK objectif : ENUM(perte_gras, prise_masse, diabete, maintien)&lt;br&gt;Clé primaire composite : (plat_id, objectif)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1365" width="610" height="117" as="geometry" />
        </mxCell>
        <mxCell id="16" value="Relations principales : une commande appartient à un utilisateur; les détails de commande référencent le catalogue; une ligne de bowl référence uniquement la commande; une formule peut être souscrite par plusieurs utilisateurs; un utilisateur peut avoir plusieurs mesures IMC et messages. La table de détails des bowls ne contient pas de FK vers PLATS." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF8DD;strokeColor=#D0B96E;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="40" y="1745" width="1940" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
