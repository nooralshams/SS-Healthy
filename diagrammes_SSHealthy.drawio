        <mxCell id="15" value="&lt;b&gt;&lt;font color='#234B36' style='font-size:14px'&gt;PLAT_OBJECTIFS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PK, FK plat_id â†’ PLATS.id&lt;br&gt;PK objectif : ENUM(perte_gras, prise_masse, diabete, maintien)&lt;br&gt;ClÃ© primaire composite : (plat_id, objectif)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=7;fillColor=#FFFFFF;strokeColor=#234B36;strokeWidth=1.5;fontSize=11;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1365" width="610" height="117" as="geometry" />
        </mxCell>
        <mxCell id="16" value="Relations principales : une commande appartient Ã  un utilisateur; les dÃ©tails de commande rÃ©fÃ©rencent le catalogue; une ligne de bowl rÃ©fÃ©rence uniquement la commande; une formule peut Ãªtre souscrite par plusieurs utilisateurs; un utilisateur peut avoir plusieurs mesures IMC et messages. La table de dÃ©tails des bowls ne contient pas de FK vers PLATS." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF8DD;strokeColor=#D0B96E;fontSize=12;fontColor=#263128;" vertex="1" parent="1">
          <mxGeometry x="40" y="1745" width="1940" height="45" as="geometry" />
